# ---------------------------------------------------------------------------
# Environment template. Copy into the real (gitignored) file:
#   Local dev   ->  .env.local / .env
#   Production  ->  .env.production   (create manually on the server)
#
# Port is NOT set here — it lives in ecosystem.config.js.
# ---------------------------------------------------------------------------

# --- Direct Namecheap Webmail / Private Email SMTP Configuration ---
# Default for Namecheap Private Email is mail.privateemail.com (SSL Port 465)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@scottprimeenergy.co.uk
SMTP_PASSWORD=your_webmail_password_here

# Lead notifications destination & sender
LEAD_RECIPIENT_EMAIL=info@scottprimeenergy.co.uk
LEAD_SENDER_EMAIL="Scottish Prime Energy" <info@scottprimeenergy.co.uk>

# --- Database (MongoDB) — upcoming backend ---
MONGODB_URI=mongodb://127.0.0.1:27017/scottish-energy

