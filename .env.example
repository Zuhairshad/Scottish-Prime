# ---------------------------------------------------------------------------
# Environment template. Copy into the real (gitignored) file:
#   Local dev   ->  .env.local
#   Production  ->  .env.production   (create manually on the server)
#
# Port is NOT set here — it lives in ecosystem.config.js.
# ---------------------------------------------------------------------------

# --- Lead capture (src/app/api/send-lead/route.ts) ---
# If RESEND_API_KEY is unset/placeholder, leads are logged, not emailed.
RESEND_API_KEY=re_your_api_key
LEAD_RECIPIENT_EMAIL=hello@scottishprimeenergy.co.uk
LEAD_SENDER_EMAIL=onboarding@resend.dev

# --- Database (MongoDB) — upcoming backend ---
MONGODB_URI=mongodb://127.0.0.1:27017/scottish-energy
