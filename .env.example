# ---------------------------------------------------------------------------
# Environment template for Scottish Prime Energy.
# This file is COMMITTED and contains no secrets. Copy it into the real file
# for your environment (those are gitignored):
#
#   Local dev   ->  cp .env.example .env.local
#   Production  ->  cp .env.example .env.production.local   (on the server)
#
# Next.js auto-loads them. Precedence (highest first):
#   .env.$(NODE_ENV).local  >  .env.local  >  .env.$(NODE_ENV)  >  .env
#   next dev        => NODE_ENV=development
#   next build/start=> NODE_ENV=production   (this is what PM2 runs)
#
# Vars WITHOUT a NEXT_PUBLIC_ prefix are server-only (never sent to the browser).
# ---------------------------------------------------------------------------

# Port the server listens on (next start / PM2 — see ecosystem.config.js)
PORT=3000

# --- Lead capture (src/app/api/send-lead/route.ts) -------------------------
# If RESEND_API_KEY is unset or left as this placeholder, the API route logs
# leads and returns success WITHOUT sending email (fine for local dev).
RESEND_API_KEY=re_your_api_key
LEAD_RECIPIENT_EMAIL=hello@scottishprimeenergy.co.uk
LEAD_SENDER_EMAIL=onboarding@resend.dev

# --- Database (MongoDB) — for the upcoming backend -------------------------
# Local example:  mongodb://127.0.0.1:27017/scottish-energy
# Production:      your Atlas / server connection string
MONGODB_URI=mongodb://127.0.0.1:27017/scottish-energy
